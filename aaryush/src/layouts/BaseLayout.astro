---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import KeyMap from '../components/KeyMap.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; ogImage?: string; path?: string; bodyClass?: string }
const { title = site.title, description = site.description, ogImage = '/og/home.png', path = Astro.url.pathname, bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0B0E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} ogImage={ogImage} path={path} />
    <script is:inline>document.documentElement.classList.add('js'); try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rot-pre'); } catch (e) {} try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { var f = 0; try { f = sessionStorage.getItem('mark-played'); sessionStorage.setItem('mark-played', '1'); } catch (e) {} if (!f) document.documentElement.classList.add('mark-first'); } } catch (e) {}</script>
    <slot name="head" />
  </head>
  <body class={bodyClass} data-home-title={site.title}>
    <div class="bg" aria-hidden="true"><i class="l1"></i><i class="l2"></i><i class="l3"></i><div class="grain"></div></div>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <KeyMap />
    <script>import '../scripts/site';</script>
    <script>import '../scripts/console-note';</script>
  </body>
</html>
