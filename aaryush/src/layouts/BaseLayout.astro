---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import KeyMap from '../components/KeyMap.astro';
import { site } from '../data/site';
import { getTopics } from '../lib/topics';
const topics = await getTopics();
const topicsJson = JSON.stringify(Object.fromEntries(topics.map((t) => [t.slug, t.name]))).replace(/</g, '\\u003c');
interface Props { title?: string; description?: string; ogImage?: string; path?: string; bodyClass?: string; bare?: boolean; skipTo?: string }
const { title = site.title, description = site.description, ogImage = '/og/home.png', path = Astro.url.pathname, bodyClass, bare = false, skipTo } = Astro.props;
// `bare` pages (the /qr tool) touch no storage and never read or keep the contact context, so they skip the mark-played flag, and scripts/contact-card.ts skips capture() when body has data-bare.
const markPart = bare ? '' : " try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { var f = 0; try { f = sessionStorage.getItem('mark-played'); sessionStorage.setItem('mark-played', '1'); } catch (e) {} if (!f) document.documentElement.classList.add('mark-first'); } } catch (e) {}";
// If the bundle never loads, .rv content would stay invisible: after 4s the page reveals it anyway (scripts/site.ts cancels this timer).
const rvGuard = " window.__rvT = setTimeout(function () { document.documentElement.classList.add('rv-fallback'); }, 4000);";
const boot = "document.documentElement.classList.add('js'); try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rot-pre'); } catch (e) {}" + markPart;
const bootAll = boot + rvGuard;
// Phones, writing only (Task 32): tell the view transition how this page was reached. A piece that walked in leaves a
// short-lived flag (see scripts/walk-in.ts); a Back to the desk or from an essay gets the soft fade-and-scale.
const reveal = "try { if ('onpagereveal' in window && matchMedia('(max-width: 559px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches && location.pathname.indexOf('/writing') === 0) addEventListener('pagereveal', function (e) { if (!e.viewTransition) return; var c = document.documentElement.classList, k = ''; try { var v = (sessionStorage.getItem('walk-in') || '').split('|'); sessionStorage.removeItem('walk-in'); if ((v[0] === 'letter' || v[0] === 'paper') && Date.now() - Number(v[1]) < 8000) k = v[0]; } catch (x) {} if (k) c.add('walk-' + k); else { var a = window.navigation && navigation.activation; if (a && a.navigationType === 'traverse') c.add('vt-back'); } }); } catch (x) {}";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0B0E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/spectral-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/karla-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} ogImage={ogImage} path={path} noindex={bare} />
    <script is:inline set:html={bootAll}></script>
    {!bare && <script is:inline set:html={reveal}></script>}
    <slot name="head" />
  </head>
  <body class={bodyClass} data-home-title={site.title} data-bare={bare ? '' : undefined}>
    {skipTo && <a class="skip mono" href={`#${skipTo}`}>Skip to content</a>}
    <div class="bg" aria-hidden="true"><i class="l1"></i><i class="l2"></i><i class="l3"></i><div class="grain"></div></div>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <KeyMap />
    <script is:inline type="application/json" id="meet-topics" set:html={topicsJson}></script>
    <script>import '../scripts/contact-card';</script>
    <script>import '../scripts/site';</script>
    <script>import '../scripts/console-note';</script>
  </body>
</html>
