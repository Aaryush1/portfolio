---
import { keyMap } from '../data/console';
---
<dialog id="keymap" class="km" aria-labelledby="km-title">
  <div class="km-sheet">
    <div class="km-head">
      <h2 id="km-title" tabindex="-1">{keyMap.title}</h2>
      <span class="km-esc" aria-hidden="true">{keyMap.hint}</span>
      <button type="button" class="km-close" data-km-close>Close</button>
    </div>
    <dl class="km-rows">
      {keyMap.rows.map((r) => (
        <div><dt><kbd>{r.keys}</kbd></dt><dd>{r.action}</dd></div>
      ))}
      <div data-km-time hidden><dt><kbd>{keyMap.time.keys}</kbd></dt><dd>{keyMap.time.action}</dd></div>
    </dl>
  </div>
</dialog>
<script>import '../scripts/keymap';</script>
<style>
.km{
  border:0;padding:0;background:transparent;color:var(--text);
  width:min(400px, calc(100vw - 32px));max-width:none;margin:auto;overflow:visible;
}
.km::backdrop{background:rgba(5,6,8,.66)}
.km-sheet{border:1px solid var(--line-2);background:rgba(10,11,14,.97)}
.km-head{display:flex;align-items:baseline;gap:12px;padding:10px 14px 10px;border-bottom:1px solid var(--line-2)}
.km-head h2{font:500 13px/1.3 var(--label);font-variant-numeric:lining-nums tabular-nums;letter-spacing:.1em;color:var(--text);margin-right:auto}
.km-head h2:focus,.km-head h2:focus-visible{outline:none}
.km-esc{font:400 12.5px/1.3 var(--label);font-variant-numeric:lining-nums tabular-nums;letter-spacing:.1em;color:var(--text-3)}
.km-close{
  font:400 13px/1 var(--label);font-variant-numeric:lining-nums tabular-nums;letter-spacing:.08em;color:var(--text-2);
  background:none;border:1px solid var(--line-2);padding:7px 10px;min-height:28px;cursor:pointer;border-radius:0;
}
.km-close:hover{color:var(--text);border-color:var(--line-3)}
.km-rows > div{display:grid;grid-template-columns:84px 1fr;border-top:1px solid var(--line)}
.km-rows > div:first-child{border-top:0}
.km-rows > div[hidden]{display:none}
.km-rows dt{font:400 14.5px/1.4 var(--label);font-variant-numeric:lining-nums tabular-nums;padding:9px 14px;border-right:1px solid var(--line-2)}
.km-rows dd{padding:9px 14px;font:400 14.5px/1.4 var(--label);font-variant-numeric:lining-nums tabular-nums;color:var(--text);letter-spacing:.02em;min-width:0}
.km-rows kbd{font:500 14.5px/1.4 var(--label);font-variant-numeric:lining-nums tabular-nums;color:var(--accent);letter-spacing:.06em}
@media (prefers-reduced-motion:no-preference){
  .km[open]{animation:km-in .18s var(--ease-out)}
  .km[open]::backdrop{animation:km-fade .18s var(--ease-out)}
  @keyframes km-in{from{opacity:0;transform:translateY(6px)}}
  @keyframes km-fade{from{opacity:0}}
}
@media (prefers-reduced-motion:reduce){
  .km,.km::backdrop{animation:none;transition:none}
}
</style>
