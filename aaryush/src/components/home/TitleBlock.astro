---
import { site, lastDeploy, lastCommit } from '../../data/site';
import Mark from '../Mark.astro';
interface Props { signed?: boolean }
const { signed = false } = Astro.props;
const { sheet } = site;
const date = lastDeploy();
const sha = lastCommit();
// The drawing-sheet title block: five rows, shared by the hero (screen) and the printed sheet (print.css restyles it).
// E14: the cell opens the revision block (scripts/revisions.ts), which moves the date into a real button (aria-expanded, aria-controls) at runtime. The cell has no role of its own, because a role on a dl row breaks the list.
// E10: the commit is revealed on hover or focus. It always takes its space (opacity only), so nothing moves.
// E13: the printed sheet adds a print-only "Signed" cell with the pencil-grey mark.
---
<dl class:list={['tblock', { 'tblock--signed': signed }]}>
  <div><dt>Dwg. no.</dt><dd>{sheet.dwg}</dd></div>
  <div><dt>Sheet</dt><dd>{sheet.sheet}</dd></div>
  <div><dt>Region</dt><dd>{sheet.region}</dd></div>
  <div class="dep">
    <dt>Last deploy</dt><dd>{date}{sha && <span class="sha"> · {sha}</span>}</dd>
  </div>
  <div><dt>Scale</dt><dd>{sheet.scale}</dd></div>
  {signed && <div class="signed print-only"><dt>Signed</dt><dd><Mark signature maskId="mark-sign" size={22} /></dd></div>}
</dl>
<style>
.tblock{display:grid;grid-template-columns:repeat(5,auto);border:1px solid var(--line-2);background:rgba(10,11,14,.85)}
.tblock > div{padding:7px 12px 8px;border-left:1px solid var(--line-2)}
.tblock > div:first-child{border-left:0}
.tblock dt{font:400 10.5px/1.3 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--text-3)}
.tblock dd{font:400 12px/1.3 var(--mono);color:var(--text);letter-spacing:.02em;margin-top:3px}
.dep :global(.dep-btn){display:block;font:inherit;letter-spacing:inherit;color:inherit;text-align:left;cursor:pointer}
.dep :global(.dep-btn:focus-visible){outline:1px solid var(--accent);outline-offset:3px;border-radius:0}
.sha{opacity:0;transition:opacity .35s var(--ease)}
.dep:hover .sha,.dep:has(:focus-visible) .sha{opacity:1}
</style>
