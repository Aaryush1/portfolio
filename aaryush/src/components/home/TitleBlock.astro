---
import { site, lastDeploy } from '../../data/site';
const { sheet } = site;
// The drawing-sheet title block: five rows, shared by the hero (screen) and the printed sheet (print.css restyles it).
---
<dl class="tblock">
  <div><dt>Dwg. no.</dt><dd>{sheet.dwg}</dd></div>
  <div><dt>Sheet</dt><dd>{sheet.sheet}</dd></div>
  <div><dt>Region</dt><dd>{sheet.region}</dd></div>
  <div><dt>Last deploy</dt><dd>{lastDeploy()}</dd></div>
  <div><dt>Scale</dt><dd>{sheet.scale}</dd></div>
</dl>
<style>
.tblock{display:grid;grid-template-columns:repeat(5,auto);border:1px solid var(--line-2);background:rgba(10,11,14,.85)}
.tblock > div{padding:7px 12px 8px;border-left:1px solid var(--line-2)}
.tblock > div:first-child{border-left:0}
.tblock dt{font:400 10.5px/1.3 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--text-3)}
.tblock dd{font:400 12px/1.3 var(--mono);color:var(--text);letter-spacing:.02em;margin-top:3px}
</style>
