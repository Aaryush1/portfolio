---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { levels } from '../../data/levels';
import { levelsFor } from '../../lib/levels';
import { buildTimeline, formatRange, numberSystems } from '../../lib/timeline';

const companies = await getCollection('companies');
const systems = await getCollection('systems');
const timeline = buildTimeline(companies, systems);
const sysNumbers = numberSystems(timeline);
const levelTitle = (n: number) => levels.find((l) => l.n === n);
---
<section class="sec" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="sec-head mono rv"><span class="n">§ 04</span><span>Work</span><span class="f">Fig. 4.1 — Timeline, newest first</span></div>
    <div class="sec-intro rv">
      <h2 class="h2" id="work-title">Companies, and the systems inside them.</h2>
      <p class="lead">Each company in a sentence, then its systems, each one built to handle a whole class of work rather than a single case.</p>
    </div>

    <div class="tl-wrap">
      <p class="next rv"><b>Next</b> — {site.next.name}. <span class="soon">{site.next.note}</span></p>

      {timeline.map(({ company, systems: syss }) => {
        const c = company.data;
        const isGroup = c.kind === 'group';
        return (
          <article class:list={['entry', 'rv', { now: c.end === null }]} id={`co-${company.id}`}>
            <div class="meta"><span class="date">{formatRange(c.start, c.end, isGroup)}</span><span class="role">{isGroup ? 'Earlier work' : c.role}</span></div>
            <div class="co">
              <h3>{c.name}</h3>
              {company.id === 'gupta-advisory' ? <blockquote>{c.summary}</blockquote> : <p class="desc">{c.summary}</p>}
              {!isGroup && (
                <a class="more" href={`/work/${company.id}`} data-popup-link>{site.companyLinkLabel(c.name)}<Icon name="arrow-right" /></a>
              )}
              {syss.length > 0 && (
                <div class:list={['cards', { three: isGroup }]}>
                  {syss.map((s) => (
                    <a class:list={['card', 'hl', { wide: syss.length === 1 }]} id={`sys-${s.id}`} href={`/work/${s.id}`} data-popup-link>
                      <div class="card-top">
                        <span>{sysNumbers.get(s.id)}</span>
                        <span class="lvs">{levelsFor(s.id, levels).map((l) => <span class="lv" title={levelTitle(l.n)?.title + (levelTitle(l.n)?.em ?? '')}>L{l.n}</span>)}</span>
                      </div>
                      <h4>{s.data.title}</h4>
                      <p>{s.data.summary}</p>
                      {s.data.outcome && <p class="out">{s.data.outcome}</p>}
                      <div class="card-open" aria-hidden="true"><span>{s.data.diagram ? 'Open schematic' : 'Read'}</span><Icon name="arrow-right" /></div>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
<style>
.tl-wrap{position:relative;margin-top:44px;padding-left:30px}
@media (min-width:860px){.tl-wrap{margin-top:64px;padding-left:44px}}
.tl-wrap::before{content:"";position:absolute;left:4px;top:30px;bottom:12px;width:1px;background:linear-gradient(to bottom, var(--line-3), var(--line-2) 85%, transparent)}
.next{position:relative;padding:0 0 28px;color:var(--text-2);font:400 13px/1.4 var(--mono);letter-spacing:.01em}
.next b{font-weight:500;color:var(--text)}
.next::before{content:"";position:absolute;left:-30px;top:4px;width:9px;height:9px;border:1px solid rgba(242,181,68,.8);background:var(--bg)}
.next::after{content:"";position:absolute;left:-26px;top:14px;height:calc(100% - 4px);border-left:1px dashed var(--line-3)}
@media (min-width:860px){.next::before{left:-44px}.next::after{left:-40px}}
.next .soon{color:var(--text-3)}
@media (prefers-reduced-motion:no-preference){.next::before{animation:breathe 3.6s var(--ease) infinite}}
@keyframes breathe{0%,100%{box-shadow:0 0 0 0 rgba(242,181,68,0)}50%{box-shadow:0 0 0 4px rgba(242,181,68,.12)}}
.entry{position:relative;padding:30px 0 38px;display:grid;gap:12px;scroll-margin-top:calc(var(--header) + 24px)}
.entry:last-child{padding-bottom:0}
@media (min-width:860px){.entry{grid-template-columns:minmax(0,3fr) minmax(0,9fr);column-gap:28px;padding:38px 0 46px}}
.entry::before{
  content:"";position:absolute;left:-30px;top:36px;width:9px;height:9px;
  background:var(--bg);border:1px solid var(--line-3);
  transition:border-color .3s var(--ease),background-color .3s var(--ease),box-shadow .3s var(--ease);
}
.entry.now::before{border-color:var(--text-2);background:radial-gradient(circle, var(--accent) 0 1.6px, var(--bg) 2px)}
@media (min-width:860px){.entry::before{left:-44px;top:44px}}
.entry:hover::before{border-color:var(--accent)}
.entry.is-target::before{animation:nodeFlash 1.8s var(--ease)}
@keyframes nodeFlash{0%,40%{border-color:var(--accent);box-shadow:0 0 0 6px rgba(242,181,68,.14)}100%{box-shadow:0 0 0 14px transparent}}
.meta{display:flex;flex-wrap:wrap;gap:4px 14px;font:400 12.5px/1.5 var(--mono);letter-spacing:.01em}
.meta .date{color:var(--text-2)}
.meta .role{color:var(--text-3)}
@media (min-width:860px){.meta{flex-direction:column;gap:6px;padding-top:6px}}
.co h3{font-size:clamp(24px, 2.6vw, 30px);font-weight:500;letter-spacing:-.028em;line-height:1.15}
.co .desc{margin-top:10px;color:var(--text-2);font-size:16.5px;line-height:1.7;max-width:40rem}
.co blockquote{margin:12px 0 0;padding-left:16px;border-left:1px solid rgba(242,181,68,.6);color:var(--text);font-size:16.5px;line-height:1.7;max-width:40rem}
.cards{margin-top:22px;display:grid;gap:12px}
@media (min-width:640px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1000px){.cards.three{grid-template-columns:repeat(3,minmax(0,1fr))}}
.card{
  position:relative;display:flex;flex-direction:column;gap:8px;color:inherit;
  background:var(--s1);border:1px solid var(--line);border-radius:14px;padding:18px 20px 16px;
  transition:border-color .25s var(--ease),background-color .25s var(--ease);
  scroll-margin-top:calc(var(--header) + 32px);
}
.card:focus-visible{outline-offset:2px}
.card:hover{border-color:var(--line-2);background:var(--s2)}
.card.wide{grid-column:1/-1}
.card-top{display:flex;justify-content:space-between;align-items:center;gap:8px;font:400 11.5px/1 var(--mono);color:var(--text-3);letter-spacing:.06em}
.lvs{display:flex;gap:4px}
.lv{font:400 11.5px/1 var(--mono);letter-spacing:.04em;color:var(--text-2);border:1px solid var(--line-2);border-radius:4px;padding:4px 6px 3px}
.card h4{font-size:16.5px;font-weight:500;letter-spacing:-.012em;line-height:1.35;margin-top:4px}
.card p{color:var(--text-2);font-size:14.5px;line-height:1.62}
.card .out{margin-top:auto;font:400 12px/1.5 var(--mono);letter-spacing:.01em;color:var(--text)}
.card .out::before{content:"→ ";color:var(--accent)}
.card-open{display:flex;align-items:center;justify-content:space-between;font:400 12px/1 var(--mono);color:var(--text-2);letter-spacing:.04em;text-transform:uppercase;padding-top:6px}
.card-open :global(svg){width:14px;height:14px;transition:transform .3s var(--ease),color .2s}
.card:hover .card-open{color:var(--text)}
.card:hover .card-open :global(svg){transform:translateX(3px);color:var(--accent)}
.card.is-target{animation:cardFlash 2.2s var(--ease)}
@keyframes cardFlash{0%,30%{border-color:rgba(242,181,68,.8);box-shadow:0 0 0 3px rgba(242,181,68,.12)}100%{border-color:var(--line);box-shadow:0 0 0 3px transparent}}
</style>
