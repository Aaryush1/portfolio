---
import { revisions } from '../../data/revisions';
// E14: the drawing's revision block. Closed until scripts/revisions.ts opens it from the title block's "Last deploy" cell.
// Never explained anywhere; hidden without JavaScript.
---
<div class="revs" id="revs" data-revs hidden>
  <table>
    <thead><tr><th scope="col">Rev</th><th scope="col">Date</th><th scope="col">Description</th></tr></thead>
    <tbody>
      {revisions.map((r) => <tr><th scope="row">{r.rev}</th><td>{r.date}</td><td>{r.description}</td></tr>)}
    </tbody>
  </table>
</div>
<script>import '../../scripts/revisions';</script>
<style>
.revs{position:absolute;right:var(--gutter);bottom:calc(100% + 6px);z-index:6;max-width:calc(100vw - var(--gutter)*2);border:1px solid var(--line-2);background:rgba(10,11,14,.96)}
.revs[hidden]{display:none}
.revs table{border-collapse:collapse;font:400 14.5px/1.3 var(--label);font-variant-numeric:lining-nums tabular-nums;letter-spacing:.02em;color:var(--text)}
.revs th,.revs td{padding:6px 12px 7px;text-align:left;font-weight:400;border-left:1px solid var(--line-2);vertical-align:baseline}
.revs th:first-child{border-left:0;color:var(--accent);width:1%}
.revs td:last-child{min-width:22em}
.revs thead th{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-3);border-bottom:1px solid var(--line-2)}
.revs thead th:first-child{color:var(--text-3)}
.revs tbody tr+tr > *{border-top:1px solid var(--line)}
.revs td:nth-child(2){color:var(--text-2);white-space:nowrap}
@media (prefers-reduced-motion:no-preference){.revs:not([hidden]){animation:revs-in .2s var(--ease-out)}@keyframes revs-in{from{opacity:0;transform:translateY(4px)}}}
</style>
