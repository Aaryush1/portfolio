---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { levels } from '../../data/levels';
import '../../styles/levels.css';

const companyLabels: Record<string, string> = { cylerity: 'Operating model', 'gupta-advisory': 'Advisory' };

const companies = await getCollection('companies');
const systems = await getCollection('systems');
const companyName = new Map(companies.map((c) => [c.id, c.data.name]));
const sysById = new Map(systems.map((s) => [s.id, s]));

/**
 * One "Explore more" item. A system with a diagram opens its own pop-up (/work/<system>); any other system opens its
 * company's pop-up, and a company ref opens the company's. The "Earlier" group has no pop-up of its own (only companies
 * do), so its systems open their own. Every slug returned has a pop-up template (workSlugs).
 */
function item(ref: string) {
  const s = sysById.get(ref);
  if (s) {
    const co = s.data.company.id;
    const hasPopup = companies.find((c) => c.id === co)?.data.kind === 'company';
    return { href: `/work/${s.data.diagram || !hasPopup ? ref : co}`, company: companyName.get(co) ?? '', label: s.data.title };
  }
  const name = companyName.get(ref);
  if (name) return { href: `/work/${ref}`, company: name, label: companyLabels[ref] ?? 'Overview' };
  throw new Error(`Level ref "${ref}" matches no system or company`);
}
---
<section class="sec" id="levels" aria-labelledby="levels-title">
  <div class="wrap">
    <div class="sec-head mono rv"><span class="n">§ 02</span><span>How AI fits</span><span class="f">Sheet 02 / 05</span></div>
    <h2 class="h2 rv" id="levels-title">Four levels where AI changes an organization.</h2>
    <p class="lead rv">Most problems show up at one level but are caused at another. I start by finding which level a problem actually lives at, then build there. Each level links to the work below that sits at it.</p>
    <!--
      Without JavaScript, and under reduced motion, this is the whole figure: four expanded floors, stacked, each with its own
      list. src/scripts/levels.ts upgrades it into the sticky schematic (and then there is exactly one copy of each link).
    -->
    <div class="sx" id="sx">
      <div class="sx-track">
        <div class="sx-stage">
          <figure class="sx-fig dg-fig">
            <div class="dg-frame sx-frame">
              <i class="reg reg-tl" aria-hidden="true"></i><i class="reg reg-tr" aria-hidden="true"></i>
              <i class="reg reg-bl" aria-hidden="true"></i><i class="reg reg-br" aria-hidden="true"></i>
              <ol class="sx-floors">
                {levels.map((l) => (
                  <li class="sx-lv" data-level={l.n}>
                    <i class="sx-sl" aria-hidden="true"></i><i class="sx-sr" aria-hidden="true"></i>
                    <span class="sx-num" aria-hidden="true">L.0{l.n}</span>
                    <h3>{l.title}<em>{l.em}</em></h3>
                    <p>{l.body}</p>
                    <h4 class="sx-more-h">Explore more</h4>
                    <ul class="sx-more">
                      {l.refs.map(item).map((c) => (
                        <li><a class="wi" href={c.href} data-popup-link><span class="wt"><em>{c.company}</em><b>{c.label}</b></span><Icon name="arrow-right" /></a></li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </div>
            <figcaption>
              <span class="sx-cap"><b>Fig. 2.1</b> — A section through an organization.</span>
              <div class="lgd"><span><i class="lg"></i>Decisions</span><span><i class="lg a"></i>Volume &amp; feedback</span></div>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import '../../scripts/levels';
</script>
