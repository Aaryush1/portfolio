---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { levels } from '../../data/levels';

const chipLabels: Record<string, string> = { cylerity: 'Operating model', 'gupta-advisory': 'Advisory' };

const companies = await getCollection('companies');
const systems = await getCollection('systems');
const companyName = new Map(companies.map((c) => [c.id, c.data.name]));
const sysById = new Map(systems.map((s) => [s.id, s]));

function chip(ref: string) {
  const s = sysById.get(ref);
  if (s) return { href: `#sys-${ref}`, company: companyName.get(s.data.company.id) ?? '', label: s.data.title };
  const name = companyName.get(ref);
  if (name) return { href: `#co-${ref}`, company: name, label: chipLabels[ref] ?? 'Overview' };
  throw new Error(`Level ref "${ref}" matches no system or company`);
}

// Lens figure geometry (viewBox units). src/scripts/lens.ts animates this same markup.
const C = 140;
const M = C - 9;
const RADII = [0.97, 0.72, 0.48, 0.24].map((f) => +(f * M).toFixed(2));
const hexR = RADII[3] * 1.15;
const hexPoints = [0, 1, 2, 3, 4, 5].map((v) => `${(C + hexR * Math.cos((v * Math.PI) / 3)).toFixed(1)},${(C + hexR * Math.sin((v * Math.PI) / 3)).toFixed(1)}`).join(' ');
---
<section class="sec" id="levels" aria-labelledby="levels-title">
  <div class="wrap">
    <div class="sec-head mono rv"><span class="n">§ 03</span><span>How AI fits</span><span class="f">Sheet 03 / 06</span></div>
    <div class="levels-grid">
      <div class="levels-head">
        <h2 class="h2 rv" id="levels-title">Four levels where AI changes an organization.</h2>
        <p class="lead rv">Most problems show up at one level but are caused at another. I start by finding which level a problem actually lives at, then build there. Each level links to the work below that sits at it.</p>
        <figure class="lvfig rv" id="lvfig" aria-hidden="true" data-c={C} data-m={M} data-zoom="0">
          <svg viewBox={`0 0 ${2 * C} ${2 * C}`} focusable="false">
            <defs><clipPath id="lvclip"><circle cx={C} cy={C} r={M + 17} /></clipPath></defs>
            <g clip-path="url(#lvclip)">
              <circle class="glow" data-glow cx={C} cy={C} r={hexR} fill-opacity="0" />
              <polygon class="hex" data-hex points={hexPoints} />
              {RADII.map((r, i) => <circle class="ring" data-ring={i} data-r={r} cx={C} cy={C} r={r} pathLength="6" stroke-width="1.3" stroke-dasharray=".86 .14" transform={`rotate(${i * 17} ${C} ${C})`} />)}
              {[0, 1].map((n) => (
                <g data-rip={n} opacity="0">
                  <circle class="rg" cx={C} cy={C} r="0" />
                  <circle class="rc" cx={C} cy={C} r="0" />
                </g>
              ))}
              {RADII.map((r, i) => <text data-lab={i} x={C + 4} y={C - r - 4}>{String(i + 1).padStart(2, '0')}</text>)}
              {RADII.map((r, i) => <circle class="hit" data-hit={i} cx={C} cy={C} r={r} />)}
            </g>
          </svg>
          <figcaption class="mono"><b>Fig. 3.1</b> — <span class="nw">Zoom in or out.</span></figcaption>
        </figure>
      </div>
      <ol class="levels rv">
        {levels.map((l) => (
          <li class="level hl" data-level={l.n}>
            <div class="lv-idx" aria-hidden="true">
              <span class="num">L.0{l.n}</span>
              <span class="meter">{[1, 2, 3, 4].map((k) => <i class={k <= l.n ? 'on' : undefined}></i>)}</span>
            </div>
            <div>
              <h3>{l.title}<em>{l.em}</em></h3>
              <p>{l.body}</p>
              <div class="seen"><span class="seen-lbl">Seen in</span>
                {l.refs.map(chip).map((c) => (
                  <a class="chip" href={c.href}><em>{c.company}</em>{c.label}<Icon name="arrow-down" /></a>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
/* Below 960px the figure is a compact lens pinned under the header while the list is in view.
   The head dissolves (display:contents) and the grid is plain block flow, so the figure's
   containing block is the whole grid and sticky can run for the length of the list. */
.levels-grid{display:block;margin-top:44px}
.levels-head{display:contents}
.levels{margin-top:20px}
@media (min-width:960px){
  .levels-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:72px;align-items:start;margin-top:56px}
  .levels-head{display:block;position:sticky;top:calc(var(--header) + 40px)}
  .levels{margin-top:0}
}
.lvfig{
  position:sticky;top:calc(var(--header) + 8px);z-index:5;
  display:flex;align-items:center;justify-content:center;gap:18px;
  margin:28px 0 0;padding:4px 0 6px;background:var(--bg);--lvfs:11px;
}
.lvfig::after{content:'';position:absolute;left:0;right:0;top:100%;height:16px;background:linear-gradient(var(--bg),transparent);pointer-events:none}
.lvfig svg{display:block;flex:none;width:104px;height:auto;overflow:visible}
.lvfig .ring{fill:none;stroke:color-mix(in srgb,var(--text-2) 38%,transparent)}
.lvfig .hex{fill:none;stroke:color-mix(in srgb,var(--text-2) 12%,transparent);stroke-width:1;stroke-linejoin:round}
.lvfig .glow{fill:var(--accent)}
.lvfig .rg{fill:none;stroke-width:8}
.lvfig .rc{fill:none;stroke-width:1.3}
.lvfig [data-rip]{pointer-events:none}
.lvfig text{display:none;font:400 var(--lvfs) var(--mono);fill:var(--text-3);letter-spacing:.06em;pointer-events:none}
.lvfig .hit{fill:transparent;stroke:none;pointer-events:all}
.lvfig figcaption{color:var(--text-3);text-align:left;max-width:11rem;text-wrap:balance}
.lvfig figcaption b{color:var(--text-2);font-weight:400}
.lvfig .nw{white-space:nowrap}
@media (min-width:960px){
  .lvfig{position:static;display:block;z-index:auto;margin:44px 0 0;width:280px;padding:0;background:none}
  .lvfig::after{display:none}
  .lvfig svg{width:100%}
  .lvfig text{display:block}
  .lvfig figcaption{margin-top:14px;max-width:none;text-wrap:wrap}
}
.levels{border:1px solid var(--line);border-radius:16px;background:var(--s1);display:grid;gap:0;overflow:hidden}
.level{
  position:relative;display:grid;grid-template-columns:48px minmax(0,1fr);gap:20px;
  padding:28px 28px 28px 24px;margin-top:2px;
  transition:background-color .3s var(--ease);
}
.level:first-child{margin-top:0}
.level:hover,.level.is-lit{background:var(--s2)}
.lv-idx{display:flex;flex-direction:column;gap:12px;padding-top:5px}
.lv-idx .num{font:500 12px/1 var(--mono);color:var(--text-3);letter-spacing:.04em;transition:color .3s var(--ease)}
.level:hover .lv-idx .num,.level:focus-within .lv-idx .num,.level.is-lit .lv-idx .num{color:var(--accent)}
.meter{display:grid;gap:3px;width:20px}
.meter i{display:block;height:3px;border-radius:1px;background:rgba(255,255,255,.08);transition:background-color .22s var(--ease),box-shadow .22s var(--ease)}
.meter i.on{background:rgba(255,255,255,.28)}
.meter i.fill{background:var(--accent);box-shadow:0 0 8px rgba(242,181,68,.35)}
.level h3{font-size:21px;font-weight:500;letter-spacing:-.02em;line-height:1.3}
.level h3 em{font-family:var(--serif);font-style:italic}
.level p{margin-top:8px;color:var(--text-2);font-size:15.5px;line-height:1.65;max-width:34rem}
.seen{margin-top:18px;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.seen-lbl{font:400 11.5px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--text-3);margin-right:4px}
.chip{
  display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 11px 0 12px;
  border:1px solid var(--line);border-radius:999px;background:var(--bg);
  font:400 12.5px/1.2 var(--mono);color:var(--text-2);letter-spacing:-.005em;
  transition:border-color .2s var(--ease),color .2s var(--ease),background-color .2s var(--ease);
}
.chip em{font-family:var(--mono);font-style:normal;color:var(--text-3);transition:color .2s}
.chip :global(svg){width:11px;height:11px;color:var(--text-3);transition:transform .25s var(--ease),color .2s}
.chip:hover{border-color:rgba(242,181,68,.45);color:var(--text);background:var(--s1)}
.chip:hover em{color:var(--text-2)}
.chip:hover :global(svg){transform:translateY(2px);color:var(--accent)}
@media (max-width:959px){
  .level{scroll-margin-top:104px} /* header + pinned lens + fade, so a row scrolled into view clears the lens */
}
@media (max-width:539px){
  .level{grid-template-columns:1fr;gap:14px;padding:24px 20px}
  .lv-idx{flex-direction:row;align-items:center;gap:14px;padding-top:0}
}
</style>
<script>
  import '../../scripts/levels';
</script>
