---
import TitleBlock from './TitleBlock.astro';
---
<!-- Print only (hidden on screen; see styles/print.css). The contact lines are filled in by scripts/site.ts on beforeprint. -->
<div class="print-only print-contact" aria-hidden="true">
  <div class="sec-head mono"><span class="n">§ 05</span><span>Contact</span><span class="f">Sheet 05 / 05</span></div>
  <div class="pc-row">
    <div class="pc-body">
      <div class="pc-js" data-print-contact></div>
      <ul class="pc-links">
        <li><span>LinkedIn</span><span>linkedin.com/in/aaryush</span></li>
        <li><span>GitHub</span><span>github.com/Aaryush1</span></li>
        <li><span>Site</span><span>aaryush.com</span></li>
      </ul>
    </div>
    <div class="print-only print-block">
      <TitleBlock signed />
    </div>
  </div>
</div>
