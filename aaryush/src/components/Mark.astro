---
// Logo mark "ag.": real Instrument Serif Italic glyph outlines (converted to paths, so no font load and no
// layout shift), a hairline baseline rule and an amber full stop. The letters are revealed by a mask whose
// stroke follows the pen path of each letter, giving a handwriting write-on. Static state = fully drawn.
// Play logic lives in src/scripts/mark.ts; the first-visit class (html.mark-first) is set in BaseLayout's head script.
interface Props { maskId?: string; signature?: boolean; size?: number }
const { maskId = 'mark-pen', signature = false, size = 25.5 } = Astro.props;
---
<svg class="mark-svg" viewBox="0 0 34 32" width={size} height={Math.round((size * 24 / 25.5) * 100) / 100} fill="none" aria-hidden="true" focusable="false" data-signature={signature ? '' : undefined}>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="-4" y="-4" width="44" height="40">
      <g stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
        <path class="pen pen-a" pathLength="100" d="M10.6 7.6 C9.8 6.9 9.2 6.9 8.6 6.9 C6.6 6.9 5 8.6 3.9 10.8 C2.8 13 1.6 15.5 1.4 18.6 C1.4 20.5 2.2 21.4 3.4 21.4 C5.5 21.4 7.6 18 9 14.5 C9.9 12.2 10.8 9.5 11.5 7.3 L10 17.8 C9.4 20.2 9.1 21.2 10.3 21.2 C11.6 21.2 12.6 18.8 13.1 17.4"/>
        <path class="pen pen-g" pathLength="100" d="M25.3 5.2 L23.4 6.3 C22.3 7 21.4 6.85 20.6 6.85 C18.4 6.85 16 9.5 15.9 12.9 C15.9 15 16.7 16.1 18.2 16.1 C21 16.1 23.1 13.5 23.1 10 L23.1 8 L23.1 10 C23.1 13.5 21 16.1 18.2 16.1 L16.5 17.2 L15 18.6 C16.5 19.7 19 20.6 21 21.5 C22 22.2 22 23 21.5 24.5 C20.5 27.3 18 27.9 16 27.9 C13.5 27.9 11.8 26.8 11.8 25.2 C11.8 24 12.8 22.8 14.6 21.3"/>
      </g>
    </mask>
  </defs>
  <g transform="translate(1.8 0)"><path class="glyphs" mask={`url(#${maskId})`} fill="currentColor" d="M2.67 22.27L2.67 22.27Q1.59 22.27 0.99 21.34Q0.39 20.41 0.39 18.61L0.39 18.61Q0.39 16.90 0.87 15.18Q1.35 13.45 2.19 11.89Q3.03 10.33 4.09 9.13Q5.16 7.93 6.34 7.23Q7.53 6.52 8.70 6.52L8.70 6.52Q9.27 6.52 9.78 6.75Q10.29 6.97 10.62 7.45L10.62 7.45Q10.80 7.72 10.98 7.72L10.98 7.72Q11.16 7.72 11.34 7.45L11.34 7.45Q11.67 6.97 11.88 6.84Q12.09 6.70 12.27 6.70L12.27 6.70Q12.66 6.70 12.57 7.12L12.57 7.12L9.90 18.61Q9.45 20.56 10.50 20.56L10.50 20.56Q11.19 20.56 11.74 19.63Q12.30 18.70 12.87 16.75L12.87 16.75Q12.96 16.42 13.26 16.42L13.26 16.42Q13.47 16.42 13.53 16.60Q13.59 16.78 13.53 17.02L13.53 17.02Q12.96 19.84 12 21.05Q11.04 22.27 9.69 22.27L9.69 22.27Q8.52 22.27 8.03 21.28Q7.53 20.29 7.92 18.58L7.92 18.58L8.31 16.93Q8.37 16.72 8.23 16.69Q8.10 16.66 8.01 16.84L8.01 16.84Q6.36 19.87 5.08 21.07Q3.81 22.27 2.67 22.27ZM3.42 20.74L3.42 20.74Q4.14 20.74 5.01 19.87Q5.88 19 6.73 17.62Q7.59 16.24 8.31 14.65Q9.03 13.06 9.46 11.59Q9.90 10.12 9.90 9.10L9.90 9.10Q9.90 7.27 8.61 7.27L8.61 7.27Q7.83 7.27 6.96 7.97Q6.09 8.68 5.29 9.88Q4.50 11.08 3.85 12.60Q3.21 14.11 2.82 15.75Q2.43 17.38 2.43 18.94L2.43 18.94Q2.43 19.99 2.69 20.36Q2.94 20.74 3.42 20.74Z M15.67 28.48L15.67 28.48Q13.30 28.48 12.07 27.61Q10.84 26.74 10.84 25.54L10.84 25.54Q10.84 24.49 11.66 23.48Q12.49 22.48 14.71 21.19L14.71 21.19Q15.04 21.01 15.08 20.79Q15.13 20.56 14.80 20.35L14.80 20.35Q13.96 19.81 13.79 19.09Q13.63 18.37 14.17 18.07L14.17 18.07L16.45 16.75Q16.75 16.60 16.77 16.38Q16.78 16.15 16.45 15.97L16.45 15.97Q15.64 15.49 15.23 14.61Q14.83 13.72 14.83 12.67L14.83 12.67Q14.83 11.05 15.63 9.66Q16.42 8.26 17.75 7.39Q19.09 6.52 20.74 6.52L20.74 6.52Q21.43 6.52 21.91 6.70L21.91 6.70Q22.27 6.82 22.45 6.46L22.45 6.46Q22.96 5.35 23.75 4.71Q24.55 4.06 25.42 4.06L25.42 4.06Q26.05 4.06 26.39 4.39Q26.74 4.72 26.74 5.29L26.74 5.29Q26.74 5.86 26.41 6.22Q26.08 6.58 25.57 6.58L25.57 6.58Q25.18 6.58 24.98 6.43Q24.79 6.28 24.64