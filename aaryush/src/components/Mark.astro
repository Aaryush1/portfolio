  <path class="rule" pathLength="100" d="M1.3 23H32.21" stroke="currentColor" stroke-opacity=".5" stroke-width="1"/>
  <circle class="stop" cx="29.71" cy="19.5" r="2.5" fill="var(--accent)"/>
</svg>
<script>import '../scripts/mark';</script>
<style>
.mark-svg{display:block;overflow:visible}
.mark-svg .pen{stroke-dasharray:100 200;stroke-dashoffset:0}
.mark-svg .rule{stroke-dasharray:100 200;stroke-dashoffset:0}
.mark-svg .stop{transform-box:fill-box;transform-origin:center}
@keyframes mk-draw{from{stroke-dashoffset:108}to{stroke-dashoffset:0}}
@keyframes mk-rule{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
@keyframes mk-pop{0%{transform:scale(0)}65%{transform:scale(1.22)}100%{transform:scale(1)}}
@media (prefers-reduced-motion:no-preference){
  /* the signature starts undrawn (JS only) and plays once when it scrolls into view; see scripts/signature.ts */
  :global(html.js) .mark-svg[data-signature] .pen{stroke-dashoffset:108}
  :global(html.js) .mark-svg[data-signature] .rule{stroke-dashoffset:100}
  :global(html.js) .mark-svg[data-signature] .stop{transform:scale(0)}
  :global(html.mark-first) .mark-svg:not([data-signature]) .pen-a,.mark-svg.is-playing .pen-a{animation:mk-draw .45s cubic-bezier(.3,.15,.35,1) 0s both}
  :global(html.mark-first) .mark-svg:not([data-signature]) .pen-g,.mark-svg.is-playing .pen-g{animation:mk-draw .55s cubic-bezier(.3,.15,.35,1) .45s both}
  :global(html.mark-first) .mark-svg:not([data-signature]) .rule,.mark-svg.is-playing .rule{animation:mk-rule .35s var(--ease-out) .85s both}
  :global(html.mark-first) .mark-svg:not([data-signature]) .stop,.mark-svg.is-playing .stop{animation:mk-pop .25s cubic-bezier(.34,1.4,.64,1) 1.15s both}
}
</style>
