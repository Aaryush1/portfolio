---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Piece from '../../components/writing/Piece.astro';
import { toPieceView } from '../../lib/writing';
import { layoutDesk } from '../../lib/writing-layout';
import '@fontsource/instrument-serif/400.css'; // upright titles on this page only
import '../../styles/writing-room.css';
const views = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(toPieceView);
const layout = layoutDesk(views);
// DOM order is visual reading order, so keyboard focus follows what the eye sees.
const ordered = layout.placements.map((place) => ({ piece: views.find((v) => v.slug === place.slug)!, place }));
---
<BaseLayout title="Writing — Aaryush Gupta" description="Essays by Aaryush Gupta on AI and how organizations work." ogImage="/og/writing.png" path="/writing">
  <main class="sec room">
    <div class="light" aria-hidden="true"><div class="window"><i></i><i></i></div><div class="pool"><i></i><i></i></div><canvas class="dust" data-dust="paused"></canvas></div>
    <div class="wrap">
    <header class="room-head">
      <h1 class="room-kicker mono">Writing</h1>
    </header>
    <div class="desk-wrap">
      <ul class="pieces desk" data-writing-list data-cols={layout.cols} style={`--cols:${layout.cols}`}>
        {ordered.map(({ piece, place }) => <Piece piece={piece} place={place} />)}
      </ul>
    </div>
  </div></main>
  <script>import '../../scripts/light-pool'; import '../../scripts/room-clock'; import '../../scripts/dust'; import '../../scripts/writing-desk';</script>
</BaseLayout>
