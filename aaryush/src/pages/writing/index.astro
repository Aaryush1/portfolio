---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Piece from '../../components/writing/Piece.astro';
import { toPieceView } from '../../lib/writing';
import '../../styles/writing-room.css';
const pieces = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(toPieceView);
---
<BaseLayout title="Writing — Aaryush Gupta" description="Essays by Aaryush Gupta on AI and how organizations work." ogImage="/og/writing.png" path="/writing">
  <main class="sec room"><div class="wrap">
    <div class="sec-head mono"><span class="n">§</span><span>Writing</span><span class="f">{pieces.length} entries</span></div>
    <h1 class="h2" style="margin-top:44px">Notes on where this is going.</h1>
    <ul class="pieces" data-writing-list>
      {pieces.map((p) => <Piece piece={p} />)}
    </ul>
  </div></main>
</BaseLayout>
